# ==============================================================================
# Git Ignore for LinkedIn Automation Suite
# ==============================================================================

# ------------------------------------------------------------------------------
# Secrets & Environment Variables (CRITICAL)
# ------------------------------------------------------------------------------
.env
.env.*
*.env
# Ensure template/example configs are committed
!.env_example
!.env.example

# ------------------------------------------------------------------------------
# Python & Bytecode
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ------------------------------------------------------------------------------
# Virtual Environments
# ------------------------------------------------------------------------------
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# ------------------------------------------------------------------------------
# LinkedIn Automation: Dynamic State & Draft Outputs
# ------------------------------------------------------------------------------
# Weekly state archive generated by archive_manager.py
weekly_archive.json

# Draft preview & execution logs
latest_posted_content.txt
*.log
logs/

# Temporary and test generated media
pollinations_flux_cover.jpg
pollinations_flux_verified.jpg
real_ai_flux_artwork.jpg
test_*_infographic.jpg
unique_cartoon_test.jpg
gemini_imagen_cover.jpg

# Dynamic assets generated during runs
assets/generated_infographic.jpg
assets/generated_cover.jpg
assets/cartoon_collage_cover.jpg
assets/downloaded_news_images/*
!assets/downloaded_news_images/.gitkeep

# ------------------------------------------------------------------------------
# Operating System & File System Artifacts
# ------------------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# ------------------------------------------------------------------------------
# IDEs & Code Editors
# ------------------------------------------------------------------------------
.vscode/
.idea/
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~
